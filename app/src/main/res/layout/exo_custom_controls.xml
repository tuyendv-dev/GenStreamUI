<?xml version="1.0" encoding="utf-8"?>
<!-- Controller tuỳ biến cho PlayerView (Media3): nút play/pause ở giữa, thanh thời gian + mute ở đáy.
     Các id exo_* được PlayerControlView tự wire; btnMute do PreviewMediaActivity tự xử lý. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Play / Pause ở chính giữa -->
    <ImageButton
        android:id="@id/exo_play_pause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter" />

    <!-- Thanh điều khiển dưới: thời gian hiện tại / seekbar / tổng thời lượng / mute -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:bar_height="3dp"
            app:played_color="@color/white"
            app:scrubber_color="@color/white"
            app:unplayed_color="#50FFFFFF"
            app:buffered_color="#80FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_up" />

    </LinearLayout>

</FrameLayout>
